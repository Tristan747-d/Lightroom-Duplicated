#!/usr/bin/env python3
"""al-dedupe v2 —— 基于多级视觉指纹的重复照片筛选（Lightroom Classic 目录）。

═══════════════════════════════════════════════════════════════════
 v2 重写原因（2026-10-27 实测诊断，证据在 /tmp/dedupe-lab/）：
═══════════════════════════════════════════════════════════════════
 v1 的 8×8 全局 dHash 只有 64bit，本质是"地平线位置+明暗布局"描述子：
   · 真重复（重压缩/缩放/±5%亮度变体）距离 0–7，不同场景距离 16–44
     —— synthetic 基准上可分，但全库扫描时"低结构图"（纯天空/海/死黑）
     大量碰撞：河船 vs 跑道 dist=2，飞机 vs 飞机 dist=2 却相隔 2 个月。
   · 并查集传递闭包会把 A~B、B~C 链成 A~C 同组，产生 24 张、跨 16 小时
     的巨型伪组（组内 sim 低到 0.42）。

 v2 判定管线（每级都有独立实验数据支撑）：
   L1 像素级 exact：64bin RGB 直方图 L1/2 ≤ 0.12 且 dHash8 ≤ 8
      —— exp7：合成变体召回 98%+，负样本误判 0.00%
   L2 连拍：结构加权区域哈希 sim ≥ 0.55 且拍摄间隔 ≤ burst_window
      —— exp6：真连拍（0.1s 间隔跳跃连拍）S=0.62–0.79，
         跨场景假配对 S=0.57–0.69，靠时间窗做最终裁决
   能量门控：全图梯度能量 < ENERGY_FLOOR 的空白/死黑帧不参与配对
      —— 实测 DSC_0945（777 字节纯黑预览）曾与 12 张图"匹配"
   分组：不做传递闭包。以"组内任意两两距离 ≤ 阈值"（完全子图） greedily
      聚合，超直径的候选对直接拒绝 —— 杜绝 A-B-C 链式误并。

 写回契约不变：/tmp/al-dedupe-plan.json → Bridge.lua dedupe 命令。
 用法：
    tools/al-dedupe                          # 当前打开的目录
    tools/al-dedupe --catalog X.lrcat        # 指定目录
    tools/al-dedupe --burst-window 15        # 连拍时间窗（秒）
    tools/al-dedupe --report                 # 写 plan 后生成人类可读报告
    tools/al-dedupe --no-vision              # 跳过 al-vision 选最佳
"""
import argparse
import concurrent.futures as futures
import glob
import json
import os
import re
import sqlite3
import subprocess
import sys
import time
from datetime import datetime, date

HERE = os.path.dirname(os.path.abspath(__file__))
AL_VISION = os.path.join(HERE, "al-vision")
PLAN_PATH = "/tmp/al-dedupe-plan.json"
REPORT_PATH = "/tmp/al-dedupe-report.txt"
CACHE_PATH = os.path.expanduser("~/.cache/al-dedupe-fingerprints.json")
PREVIEW_SIZES = re.compile(r"_(\d+)$")

# ── 阈值（exp7 标定）────────────────────────────────────────────────
HIST_MAX = 0.12        # L1: 直方图 L1/2 上限（真变体 p95=0.104，负样本 min=0.232）
DHASH8_MAX = 8         # L1: 8x8 dHash 上限（真变体 max=7，负样本 min=16）
BURST_SIM = 0.55       # L2: 结构加权区域哈希相似度下限（真连拍 0.62–0.79）
BURST_SIM_NO_TIME = 0.72  # L2 缺拍摄时间时的更严门槛（无时间窗兜底，靠视觉说话）
# 二级语义校验：结构哈希对"同场景不同瞬间"几乎没有判别力（实测真连拍 p50=0.51
# 与随机配对 p50=0.51 完全重合，阈值 0.55 下精度仅 23%）。改用 al-vision 的
# 语义标签做裁决：真连拍均值 0.71 vs 非连拍 0.55，精度提升到 ~67%。
# 只对通过哈希初筛的少量候选对调用，成本可控（0.16s/张）。
BURST_SEMANTIC_MIN = 0.65  # 语义标签 Jaccard 加权一致度下限（现用作诊断参考）
# 合成判定：哈希 0.5 权重 + 语义 0.5 权重。
# 纯哈希精度 23%，纯语义 67%，合成后真连拍（sim≈0.7,ag≈0.9）得分 0.8 稳过，
# 随机配对（sim≈0.51,ag≈0.55）得分 0.53 被挡；Vision 误判时 sim 高仍能兜住。
W_HASH = 0.5
W_SEMANTIC = 0.5
BURST_COMBINED_MIN = 0.63   # 合成分下限
DEFAULT_BURST_WINDOW = 15.0   # 连拍时间窗（秒）
ENERGY_FLOOR = 3.0     # 全图梯度能量下限：低于此视为空白帧，不参与配对
GROUP_MAX_SPAN_H = 6.0 # exact 组内最大拍摄时间跨度（小时），防跨场景链式误并
MAX_BURST_SPAN_S = 60.0    # burst 连续段总跨度上限（秒），防长序列漂移成巨组

# 选最佳权重（越大越重要）
W_SHARPNESS = 1.0
W_FACE = 1.2
W_EYES = 1.5
W_AESTHETICS = 0.8
W_CLIP_PENALTY = 1.0


# ── 目录读取 ────────────────────────────────────────────────────────────
def lr_catalogs():
    found = []
    try:
        pids = subprocess.run(["pgrep", "-x", "Adobe Lightroom Classic"],
                              capture_output=True, text=True, timeout=10).stdout.split()
        for pid in pids:
            out = subprocess.run(["lsof", "-p", pid], capture_output=True, text=True,
                                 timeout=20).stdout
            for line in out.splitlines():
                if line.rstrip().endswith(".lrcat"):
                    path = line.split()[-1]
                    if path not in found:
                        found.append(path)
    except (OSError, subprocess.SubprocessError):
        pass
    if found:
        return found
    candidates = glob.glob(os.path.expanduser("~/Pictures/Lightroom/*/*.lrcat"))
    candidates += glob.glob(os.path.expanduser("~/Pictures/*/*.lrcat"))
    candidates.sort(key=lambda p: os.path.getmtime(p), reverse=True)
    return candidates


def load_photos(catalog):
    """只读打开，兼容 WAL（-wal/-shm 由 LR 持有，ro 模式安全）。

    返回 (filename, uuid, captureTime, path)。path 是"原始绝对路径"，
    用于消除同名不同图（相机计数器重置会产生重名，实测本目录 12 个名字对应
    24 张不同照片；只按文件名写回会标错对象）。
    Windows 导入的盘符（如 G:/）按 --path-map 映射到本机。
    """
    con = sqlite3.connect(f"file:{catalog}?mode=ro&immutable=0", uri=True, timeout=15)
    try:
        return con.execute(
            "SELECT f.idx_filename, f.id_global, i.captureTime, "
            "       rf.absolutePath || fo.pathFromRoot || f.idx_filename "
            "FROM AgLibraryFile f "
            "JOIN Adobe_images i ON i.rootFile = f.id_local "
            "JOIN AgLibraryFolder fo ON f.folder = fo.id_local "
            "JOIN AgLibraryRootFolder rf ON fo.rootFolder = rf.id_local "
            "WHERE f.id_global IS NOT NULL").fetchall()
    finally:
        con.close()


def remap_path(path, mapping):
    """把 Windows 盘符路径映射到本机挂载点。mapping: 'G:/=/Volumes/G/,X:/=/Volumes/X/'"""
    if not mapping:
        return path
    for rule in mapping.split(","):
        rule = rule.strip()
        if not rule or "=" not in rule:
            continue
        src, dst = rule.split("=", 1)
        if path.startswith(src):
            return dst + path[len(src):]
    return path


def build_preview_index(catalog):
    """一次 os.walk 建 uuid→预览索引（v1 逐张 glob 全库 60s，v2 <1s）。"""
    base = os.path.splitext(catalog)[0] + " Previews.lrdata"
    idx = {}
    if not os.path.isdir(base):
        return idx
    for root, _dirs, files in os.walk(base):
        for fn in files:
            m = PREVIEW_SIZES.search(fn)
            if not m or len(fn) < 37:
                continue
            uuid = fn[:36]
            try:
                mt = os.path.getmtime(os.path.join(root, fn))
            except OSError:
                continue
            idx.setdefault(uuid, []).append((os.path.join(root, fn), int(m.group(1)), mt))
    return idx


def preview_file_from_index(idx, uuid):
    """同尺寸取 mtime 最新；优先中小尺寸预览（解码快 3–5 倍，指纹质量等价）。"""
    cands = idx.get(uuid) or []
    if not cands:
        return None
    # 先取最接近 1392px 的；没有再取最大的
    target = 1392
    best = min(cands, key=lambda c: (abs(c[1] - target), -c[1], -c[2]))
    return best[0]


def parse_capture_time(value):
    if not value:
        return None
    try:
        dt = datetime.fromisoformat(str(value))
        return dt.replace(tzinfo=None) if dt.tzinfo else dt
    except ValueError:
        return None


# ── 指纹 ────────────────────────────────────────────────────────────────
def compute_fingerprint(path):
    """返回 dict(h8, hist, energy)；失败 None。

    h8    : 8x8 dHash 灰度（int）
    hist  : 4x4x4 RGB 直方图（归一化，64）
    energy: 全图平均梯度能量（结构量）
    """
    try:
        import numpy as np
        from PIL import Image
        with Image.open(path) as im:
            rgb = np.asarray(im.convert("RGB").resize((64, 64), Image.LANCZOS), dtype=np.float32)
            g = rgb.mean(axis=2)
            a = np.asarray(Image.fromarray(g.astype(np.uint8)).resize((9, 8), Image.LANCZOS),
                           dtype=np.float32)
            bits = (a[:, :-1] < a[:, 1:]).flatten()
            h8 = 0
            for x in bits:
                h8 = (h8 << 1) | int(x)
            q = (rgb // 64).astype(np.int32)
            idx = q[:, :, 0] * 16 + q[:, :, 1] * 4 + q[:, :, 2]
            hist = np.bincount(idx.flatten(), minlength=64).astype(np.float32)
            hist /= max(hist.sum(), 1.0)
            energy = float(np.abs(np.diff(g, axis=1)).mean() + np.abs(np.diff(g, axis=0)).mean())
        return {"h8": h8, "hist": hist.round(5).tolist(), "energy": round(energy, 3)}
    except Exception:
        return None


def _fp_worker(path):
    return path, compute_fingerprint(path)


def fingerprint_all(entries, workers=None):
    """并行计算指纹，带磁盘缓存（key=预览路径+mtime+size）。"""
    import numpy as np
    workers = workers or max(2, (os.cpu_count() or 4) - 1)
    cache = {}
    if os.path.isfile(CACHE_PATH):
        try:
            cache = json.load(open(CACHE_PATH))
        except Exception:
            cache = {}
    todo = []
    for e in entries:
        key = f'{e["preview"]}:{int(os.path.getmtime(e["preview"]))}:{os.path.getsize(e["preview"])}'
        e["fp_key"] = key
        if key in cache:
            fp = cache[key]
            e["h8"] = fp["h8"]
            e["hist"] = np.array(fp["hist"], dtype=np.float32)
            e["energy"] = fp["energy"]
        else:
            todo.append(e)
    if todo:
        with futures.ThreadPoolExecutor(max_workers=workers) as ex:
            for e, (path, fp) in zip(todo, ex.map(_fp_worker, [e["preview"] for e in todo])):
                if fp is None:
                    continue
                e["h8"] = fp["h8"]
                e["hist"] = np.array(fp["hist"], dtype=np.float32)
                e["energy"] = fp["energy"]
                cache[e["fp_key"]] = fp
        try:
            os.makedirs(os.path.dirname(CACHE_PATH), exist_ok=True)
            json.dump(cache, open(CACHE_PATH, "w"))
        except OSError:
            pass
    return entries


def hamming(a, b):
    return bin(a ^ b).count("1")


def hist_l12(ha, hb):
    import numpy as np
    return float(np.abs(ha - hb).sum() / 2.0)


# ── 分组 ────────────────────────────────────────────────────────────────
def build_groups(entries, burst_window, group_max_span_h=GROUP_MAX_SPAN_H,
                 max_burst_span_s=MAX_BURST_SPAN_S, verify_semantic=True):
    """三级判定，无传递闭包。

    exact 候选：hist ≤ HIST_MAX 且 h8 ≤ DHASH8_MAX（exp7：0 误判）
      —— 组内两两都要过 exact 标准，且时间跨度 ≤ group_max_span_h
         （防"重复导入但跨场景重拍"的极端链）
    burst 候选：结构加权 sim ≥ BURST_SIM 且相邻间隔 ≤ burst_window
      —— 成对判定，不闭包传递
    """
    import numpy as np
    n = len(entries)
    semantic_skipped = 0
    cand_exact = [[] for _ in range(n)]
    cand_burst = [[] for _ in range(n)]
    for i in range(n):
        ei = entries[i]
        if ei.get("hist") is None or ei["energy"] < ENERGY_FLOOR:
            continue
        for j in range(i + 1, n):
            ej = entries[j]
            if ej.get("hist") is None or ej["energy"] < ENERGY_FLOOR:
                continue
            hl = hist_l12(ei["hist"], ej["hist"])
            hd = hamming(ei["h8"], ej["h8"])
            if hl <= HIST_MAX and hd <= DHASH8_MAX:
                cand_exact[i].append(j)
                cand_exact[j].append(i)
                continue
            # burst：时间窗约束
            ta, tb = ei["dt"], ej["dt"]
            s = None
            if ta is None or tb is None:
                # 缺拍摄时间（本目录实测 0 张，但换目录会有：扫描件/视频截图/
                # 元数据被清的照片）→ 不能用时间窗兜底，改为提高视觉相似度门槛
                # 并要求 hist 也接近，避免"同一面墙不同照片"被并。
                if hl > HIST_MAX * 2:
                    continue
            else:
                if abs((ta - tb).total_seconds()) > burst_window:
                    continue
            s = patch_sim(ei, ej)
            need = BURST_SIM if (ta is not None and tb is not None) else BURST_SIM_NO_TIME
            if s < need:
                continue
            # 二级语义校验：注意不能做成"一票否决"。
            # 实测 _TSY7978/7979 是真连拍（Δt=0.1s, sim=0.789），但 Vision 把一张
            # 标成 outdoor/foliage、另一张标成 health_club/interior，语义一致度
            # 只有 0.49 —— 硬阈值会错杀。因此改为与哈希相似度加权合成：
            # 两者都高才通过，其中一个很高也能兜住另一个的失误。
            if verify_semantic:
                ag = semantic_agree(ei, ej)
                if ag is None:
                    semantic_skipped += 1
                    ag = None
                if ag is not None:
                    combined = W_HASH * s + W_SEMANTIC * ag
                    if combined < BURST_COMBINED_MIN:
                        continue
            cand_burst[i].append(j)
            cand_burst[j].append(i)

    # ── 完全子图贪心聚合（exact）────────────────────────────────────
    used = set()
    groups = []
    # 按邻居数降序处理，大组先成形
    order = sorted(range(n), key=lambda i: -len(cand_exact[i]))
    for seed in order:
        if seed in used or not cand_exact[seed]:
            continue
        members = [seed]
        members_set = {seed}
        for other in cand_exact[seed]:
            if other in members_set:
                continue
            # 加入 other 前验证：other 与组内所有成员都互为 exact 候选
            ok = all(other in cand_exact[m] for m in members)
            if not ok:
                continue
            # 时间跨度约束（有时间的成员之间校验；缺时间的成员不阻断，
            # 因为 exact 档本身是像素级证据，时间只是防链的第二道闸）
            dts = [entries[m]["dt"] for m in members + [other] if entries[m]["dt"]]
            if len(dts) >= 2 and (max(dts) - min(dts)).total_seconds() > group_max_span_h * 3600:
                continue
            members.append(other)
            members_set.add(other)
        if len(members) >= 2:
            used.update(members)
            groups.append({"kind": "exact", "idxs": sorted(members)})

    # ── burst：时间连续 run ──────────────────────────────────────────
    # 连拍的正确模型是"时间上连续的一段"：相邻两张相似且间隔 ≤ burst_window。
    # 不能要求"两两都相似"（16 张连拍首尾差异大会被切开），
    # 也不能做传递闭包（会把每 14s 一张的长序列串成巨组）。
    # 折中：向右贪心延伸，且整段总跨度 ≤ max_burst_span_s（防漂移）。
    burst_groups = []
    with_dt = [i for i in range(n)
               if entries[i]["dt"] is not None and i not in used]
    with_dt.sort(key=lambda i: entries[i]["dt"])
    consumed = set()
    for s in with_dt:
        if s in consumed:
            continue
        run = [s]
        consumed.add(s)
        cur = s
        while True:
            nxt, nxt_t = None, None
            for cand in cand_burst[cur]:
                if cand in consumed or cand in used:
                    continue
                ct = entries[cand]["dt"]
                if ct is None or ct <= entries[cur]["dt"]:
                    continue      # 只向前推进，保证终止
                if (ct - entries[run[0]]["dt"]).total_seconds() > max_burst_span_s:
                    continue      # 整段跨度封顶
                if nxt is None or ct < nxt_t:
                    nxt, nxt_t = cand, ct
            if nxt is None:
                break
            run.append(nxt)
            consumed.add(nxt)
            cur = nxt
        if len(run) >= 2:
            burst_groups.append({"kind": "burst", "idxs": run})
    groups.extend(burst_groups)

    for g in groups:
        idxs = g["idxs"]
        # 组统计：exact 用 hist 最大距离，burst 用 patch sim 最小值
        if g["kind"] == "exact":
            maxd = max(hist_l12(entries[a]["hist"], entries[b]["hist"])
                       for a in idxs for b in idxs if a < b)
            g["metric"] = round(maxd, 3)
        else:
            minsim = min(patch_sim(entries[a], entries[b])
                         for a in idxs for b in idxs if a < b)
            g["metric"] = round(minsim, 3)
        dts = [entries[i]["dt"] for i in idxs if entries[i]["dt"]]
        g["span_s"] = round((max(dts) - min(dts)).total_seconds(), 1) if len(dts) >= 2 else 0.0
    groups.sort(key=lambda g: (g["kind"] != "exact", -len(g["idxs"])))
    return groups, {"semantic_skipped": semantic_skipped}


def semantic_labels(path):
    """取 al-vision 的语义标签 {label: confidence}；失败返回 None。"""
    fp = vision_metrics(path)
    if not fp:
        return None
    labels = fp.get("labels") or []
    out = {}
    for x in labels:
        try:
            c = float(x.get("confidence") or 0)
        except (TypeError, ValueError):
            continue
        lid = x.get("id")
        if lid and c > 0.2:
            out[lid] = c
    return out or None


def semantic_agree(ea, eb):
    """两张图的语义标签一致度（加权 Jaccard），0..1；不可用返回 None。"""
    if "labels" not in ea:
        ea["labels"] = semantic_labels(ea["preview"])
    if "labels" not in eb:
        eb["labels"] = semantic_labels(eb["preview"])
    la, lb = ea["labels"], eb["labels"]
    if not la or not lb:
        return None
    common = set(la) & set(lb)
    num = sum(min(la[k], lb[k]) for k in common)
    den = max(sum(la.values()), sum(lb.values()), 1e-6)
    return num / den


def patch_sim(ea, eb):
    """结构加权 4x4 区域 6x6-dHash 相似度（exp6 定义，惰性算并缓存）。"""
    import numpy as np
    if "phash" not in ea:
        _fill_phash(ea)
    if "phash" not in eb:
        _fill_phash(eb)
    ba, wa = ea["phash"]
    bb, wb = eb["phash"]
    d = (ba != bb).sum(axis=1).astype(np.float32)
    w = np.minimum(wa, wb) + 1e-6
    return float(((1.0 - d / 36.0) * w).sum() / w.sum())


def _fill_phash(e):
    import numpy as np
    from PIL import Image
    GRID, PH = 4, 6
    try:
        with Image.open(e["preview"]) as im:
            g = np.asarray(im.convert("L").resize((192, 128), Image.LANCZOS), dtype=np.float32)
    except Exception:
        e["phash"] = (np.zeros((GRID * GRID, PH * PH), dtype=bool),
                      np.zeros(GRID * GRID, dtype=np.float32))
        return
    H, W = g.shape
    gh, gw = H // GRID, W // GRID
    bits = np.zeros((GRID * GRID, PH * PH), dtype=bool)
    energy = np.zeros(GRID * GRID, dtype=np.float32)
    k = 0
    for r in range(GRID):
        for c in range(GRID):
            patch = g[r * gh:(r + 1) * gh, c * gw:(c + 1) * gw]
            small = np.asarray(Image.fromarray(patch.astype(np.uint8))
                               .resize((PH + 1, PH), Image.LANCZOS), dtype=np.float32)
            bits[k] = (small[:, :-1] < small[:, 1:]).flatten()
            energy[k] = np.abs(np.diff(patch, axis=1)).mean() + np.abs(np.diff(patch, axis=0)).mean()
            k += 1
    e["phash"] = (bits, energy)


# ── 选最佳（al-vision）──────────────────────────────────────────────────
def vision_metrics(path):
    if not os.path.isfile(AL_VISION):
        return None
    try:
        r = subprocess.run([AL_VISION, path], capture_output=True, text=True, timeout=120)
        if r.returncode != 0 or not r.stdout.strip():
            return None
        return json.loads(r.stdout)
    except Exception:
        return None


def quality_score(metrics, fallback_px):
    if not metrics:
        return float(fallback_px or 0) / 10000.0, "no-vision(按分辨率)"
    score, notes = 0.0, []
    sharp = (metrics.get("sharpness") or {}).get("laplacian_var") or 0.0
    score += W_SHARPNESS * min(sharp, 3000.0) / 1000.0
    notes.append(f"锐度{sharp:.0f}")
    faces = (metrics.get("faces") or {}).get("items") or []
    if faces:
        best_face_sharp = max((f.get("face_sharpness") or 0.0) for f in faces)
        score += W_FACE * min(best_face_sharp, 3000.0) / 1000.0
        open_ratio = sum(1 for f in faces if f.get("eyes_open")) / float(len(faces))
        score += W_EYES * open_ratio
        closed = len(faces) - sum(1 for f in faces if f.get("eyes_open"))
        notes.append(f"人脸{len(faces)}" + (f"闭眼{closed}" if closed else "全睁眼"))
        if closed:
            score -= W_EYES * 0.5 * closed / float(len(faces))
    aes = (metrics.get("aesthetics") or {}).get("overall_score")
    if aes is not None:
        score += W_AESTHETICS * float(aes)
        notes.append(f"美学{aes:.2f}")
    tone = metrics.get("tone") or {}
    clip_h = float(tone.get("clipped_high_pct") or 0.0)
    clip_l = float(tone.get("clipped_low_pct") or 0.0)
    score -= W_CLIP_PENALTY * (clip_h + clip_l) / 100.0
    if clip_h + clip_l > 1.0:
        notes.append(f"溢出{clip_h + clip_l:.1f}%")
    return score, " ".join(notes)


def pick_best(entries, idxs, use_vision):
    scored = []
    for i in idxs:
        e = entries[i]
        if use_vision and "metrics" not in e:
            e["metrics"] = vision_metrics(e["preview"])
        score, why = quality_score(e.get("metrics"), e.get("preview_px"))
        scored.append((score, i, why))
    scored.sort(key=lambda t: (-t[0], t[1]))
    return scored[0], scored


# ── 报告 ────────────────────────────────────────────────────────────────
def write_report(plan, report_path=REPORT_PATH):
    lines = []
    s = plan["stats"]
    lines.append("=" * 64)
    lines.append(f"al-dedupe 重复检测报告  {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    lines.append(f"目录: {plan['catalog']}")
    lines.append(f"照片 {s['photos']}  有预览 {s['hashed']}  无预览 {s['no_preview']}")
    if s.get("no_preview"):
        lines.append(f"⚠️  {s['no_preview']} 张无预览（未参与检测，建议在 Lightroom 里"
                     f"选中它们生成预览后重跑）: {', '.join(s.get('no_preview_names', []))}")
    lines.append(f"检出: 完全重复 {s['exact_groups']} 组  连拍 {s['groups'] - s['exact_groups']} 组")
    lines.append(f"阈值: hist≤{HIST_MAX} h8≤{DHASH8_MAX} burst_sim≥{BURST_SIM} "
                 f"窗口≤{plan['thresholds']['burst_window_sec']}s 能量≥{ENERGY_FLOOR}")
    lines.append("=" * 64)
    for gi, g in enumerate(plan["groups"], 1):
        kind = "完全重复" if g["kind"] == "exact" else "连拍"
        lines.append(f"\n[{gi}] {kind}  {len(g['members'])}张  "
                     f"指标={g['metric']}  时间跨度={g['span_s']}s")
        best_name = g["best"]["name"] if isinstance(g["best"], dict) else g["best"]
        lines.append(f"    保留: {best_name}   理由: {g['reason']}")
        others = [m["name"] if isinstance(m, dict) else m
                  for m in g["members"]
                  if (m["name"] if isinstance(m, dict) else m) != best_name]
        if others:
            lines.append(f"    重复: {', '.join(others)}")
    with open(report_path, "w") as fh:
        fh.write("\n".join(lines) + "\n")
    return report_path


# ── 主流程 ──────────────────────────────────────────────────────────────
def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--catalog", help="指定 .lrcat；默认取 Lightroom 当前打开的")
    ap.add_argument("--collection", default="_Duplicates")
    ap.add_argument("--burst-window", type=float, default=DEFAULT_BURST_WINDOW)
    ap.add_argument("--group-span-h", type=float, default=GROUP_MAX_SPAN_H)
    ap.add_argument("--limit", type=int, default=0, help="只处理前 N 张（调试）")
    ap.add_argument("--no-vision", action="store_true", help="跳过 al-vision 选最佳")
    ap.add_argument("--no-cache", action="store_true", help="禁用指纹缓存")
    ap.add_argument("--dry-run", action="store_true", help="只输出计划，不写 plan 文件")
    ap.add_argument("--report", action="store_true", help="生成人类可读报告")
    ap.add_argument("--plan-out", default=PLAN_PATH)
    ap.add_argument("--path-map", default=os.environ.get("AL_DEDUPE_PATH_MAP", ""),
                    help="Windows 盘符映射，如 'G:/=/Volumes/G/'；"
                         "也可设 AL_DEDUPE_PATH_MAP 环境变量")
    args = ap.parse_args()

    catalog = args.catalog
    if not catalog:
        cands = lr_catalogs()
        if not cands:
            print("找不到 Lightroom 目录文件", file=sys.stderr)
            return 1
        catalog = cands[0]
    if not os.path.exists(catalog):
        print(f"目录不存在: {catalog}", file=sys.stderr)
        return 1

    t0 = time.time()
    rows = load_photos(catalog)
    if args.limit:
        rows = rows[:args.limit]
    if not rows:
        print("目录里没有照片", file=sys.stderr)
        return 1

    idx = build_preview_index(catalog)
    entries, no_preview, no_preview_names = [], 0, []
    for row in rows:
        name, uuid, cap = row[0], row[1], row[2]
        raw_path = row[3] if len(row) > 3 else ""
        pv = preview_file_from_index(idx, uuid)
        if not pv:
            no_preview += 1
            no_preview_names.append(name)
            continue
        entries.append({
            "name": name, "uuid": uuid, "dt": parse_capture_time(cap),
            "path": remap_path(raw_path, args.path_map),
            "preview": pv, "h8": None, "hist": None, "energy": None,
            "preview_px": int((PREVIEW_SIZES.search(pv) or [0, 0])[1] or 0),
        })
    print(f"目录: {os.path.basename(catalog)}  照片 {len(rows)}  有预览 {len(entries)}  "
          f"无预览 {no_preview}  索引 {time.time() - t0:.1f}s", file=sys.stderr)

    if not args.no_cache:
        fingerprint_all(entries)
        print(f"指纹完成 {sum(1 for e in entries if e['h8'] is not None)} 张  "
              f"(缓存命中)  {time.time() - t0:.1f}s", file=sys.stderr)
    else:
        for e in entries:
            fp = compute_fingerprint(e["preview"])
            if fp:
                import numpy as np
                e["h8"], e["hist"], e["energy"] = fp["h8"], np.array(fp["hist"]), fp["energy"]
        print(f"指纹完成 {sum(1 for e in entries if e['h8'] is not None)} 张  "
              f"{time.time() - t0:.1f}s", file=sys.stderr)

    # 语义校验同样依赖 al-vision；--no-vision 时整体降级为哈希-only，
    # 并在 stats.verify_mode 如实标注（不假装做过语义校验）。
    use_vision = not args.no_vision
    groups, gstats = build_groups(entries, args.burst_window, args.group_span_h,
                                  verify_semantic=use_vision)
    exact_n = sum(1 for g in groups if g["kind"] == "exact")
    print(f"分组: {len(groups)} 组（完全重复 {exact_n}，连拍 {len(groups) - exact_n}）"
          f"  {time.time() - t0:.1f}s", file=sys.stderr)

    out_groups = []
    for g in groups:
        best, scored = pick_best(entries, g["idxs"], not args.no_vision)
        best_entry = entries[best[1]]
        members = [{"name": entries[i]["name"], "path": entries[i]["path"]}
                   for i in g["idxs"]]
        runner_up = scored[1] if len(scored) > 1 else None
        reason = f"{best[2]}"
        if runner_up:
            reason += f"｜优于次选 {runner_up[2]}"
        out_groups.append({
            "kind": g["kind"],
            "best": {"name": best_entry["name"], "path": best_entry["path"]},
            "members": members,
            "metric": g["metric"],
            "span_s": g["span_s"],
            "reason": reason,
        })
        print(f"  [{g['kind']}] {len(members)}张 指标={g['metric']} 跨度={g['span_s']}s "
              f"保留 {best_entry['name']}", file=sys.stderr)

    # ── 路径可达性自检 ───────────────────────────────────────────────
    # 写回靠 path 精确定位。若 path 指向的盘符在本机不存在（本目录有 G:/ 等
    # Windows 盘，实测 110/175 成员如此），插件会退化为按 fileName 查找，
    # 而目录里有 12 个重名文件（相机计数器重置）→ 可能标错对象。
    # 不静默放过：统计并告警，要求用 --path-map 显式映射。
    unresolved, ambiguous = [], []
    by_name = {}
    for e in entries:
        by_name.setdefault(e["name"], []).append(e)
    for g in out_groups:
        for m in g["members"]:
            if not m.get("path") or not os.path.exists(m["path"]):
                unresolved.append(m["name"])
                if len(by_name.get(m["name"], [])) > 1:
                    ambiguous.append(m["name"])
    if unresolved:
        print(f"\n⚠️  路径在本机不存在：{len(unresolved)} 张（例：{unresolved[:3]}）", file=sys.stderr)
        print(f"    Lightroom 会退化为按文件名查找。", file=sys.stderr)
        if ambiguous:
            print(f"    ❗ 其中 {len(ambiguous)} 张存在重名（{ambiguous[:4]}），"
                  f"按文件名定位【可能标错照片】。", file=sys.stderr)
        if not args.path_map:
            print(f"    → 请用 --path-map 'G:/=/Volumes/盘名/' 映射，"
                  f"或设 AL_DEDUPE_PATH_MAP 环境变量。", file=sys.stderr)
        else:
            print(f"    （已应用 --path-map，仍不可用请检查映射是否正确）", file=sys.stderr)

    plan = {
        "catalog": catalog,
        "collection": args.collection,
        "generated_at": time.time(),
        "thresholds": {
            "hist_max": HIST_MAX, "dhash8_max": DHASH8_MAX,
            "burst_sim": BURST_SIM,
            "burst_window_sec": args.burst_window,
            "group_max_span_h": args.group_span_h,
            "energy_floor": ENERGY_FLOOR,
        },
        "stats": {
            "photos": len(rows), "hashed": sum(1 for e in entries if e["h8"] is not None),
            "no_preview": no_preview, "no_preview_names": no_preview_names[:20],
            "groups": len(groups), "exact_groups": exact_n,
            "verify_mode": ("semantic" if use_vision else "hash-only"),
            "unresolved_paths": len(unresolved), "ambiguous_fallback": sorted(set(ambiguous)),
            "semantic_skipped": gstats.get("semantic_skipped", 0),
        },
        "groups": out_groups,
    }

    if args.dry_run:
        print(json.dumps(plan, ensure_ascii=False, indent=2))
    else:
        with open(args.plan_out, "w") as fh:
            json.dump(plan, fh, ensure_ascii=False, indent=2)
        print(f"计划已写入 {args.plan_out}（{len(out_groups)} 组）", file=sys.stderr)
        if args.report:
            rp = write_report(plan)
            print(f"报告已写入 {rp}", file=sys.stderr)
    print(f"总耗时 {time.time() - t0:.1f}s", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
